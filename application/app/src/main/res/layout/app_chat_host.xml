<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/home_white">
    <LinearLayout android:id="@+id/home_chat_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/home_chat_back" android:layout_width="44dp" android:layout_height="52dp" android:background="@android:color/transparent" android:src="@drawable/uikit_ic_back" android:padding="12dp" android:contentDescription="@string/home_back"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_chat_title" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:gravity="center" android:textSize="18sp" android:textColor="@color/home_text" android:maxLines="1" android:ellipsize="end"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/home_chat_more" android:layout_width="wrap_content" android:layout_height="52dp" android:minWidth="44dp" android:text="@string/home_more" android:background="@android:color/transparent"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/home_chat_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
