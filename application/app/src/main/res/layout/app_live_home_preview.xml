<?xml version="1.0" ?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/home_feed_refresh" android:layout_width="match_parent" android:layout_height="match_parent">
        <androidx.viewpager2.widget.ViewPager2 android:id="@+id/home_feed_pager" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout android:id="@+id/home_feed_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
        <ProgressBar android:id="@+id/home_feed_loading" android:layout_width="32dp" android:layout_height="32dp"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_feed_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/home_white" android:textSize="14sp"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/home_feed_retry" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/home_retry"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/home_feed_more" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="bottom|center_horizontal" android:text="@string/home_retry" android:visibility="gone"/>
    <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/home_feed_close" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end" android:layout_marginEnd="3dp" android:padding="14dp" android:src="@drawable/home_live_close" android:background="@android:color/transparent" android:contentDescription="@string/home_close"/>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/home_feed_return" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="top|start" android:layout_marginStart="12dp" android:text="@string/home_back_preview" android:visibility="gone"/>
</merge>
