<?xml version="1.0" ?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.appcompat.widget.AppCompatImageView android:id="@+id/home_preview_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="@drawable/home_card_background"/>
    <FrameLayout android:id="@+id/home_preview_player" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <FrameLayout android:id="@+id/home_preview_overlay" android:layout_width="match_parent" android:layout_height="match_parent">
        <View android:id="@+id/home_preview_top_gradient" android:layout_width="match_parent" android:layout_height="120dp"/>
        <View android:id="@+id/home_preview_bottom_gradient" android:layout_width="match_parent" android:layout_height="242dp" android:layout_gravity="bottom"/>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/home_preview_enter" android:layout_width="226dp" android:layout_height="46dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="174dp" android:background="@drawable/home_enter_background" android:text="@string/home_enter" android:textColor="@color/home_white" android:textSize="17sp" android:fontFamily="sans-serif-medium"/>
        <androidx.appcompat.widget.AppCompatTextView android:layout_width="wrap_content" android:layout_height="24dp" android:minWidth="62dp" android:paddingHorizontal="8dp" android:layout_gravity="bottom|start" android:layout_marginStart="20dp" android:layout_marginBottom="123dp" android:gravity="center" android:text="@string/home_live_badge" android:background="@drawable/home_live_badge_background" android:textColor="@color/home_white" android:textSize="12sp"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_preview_owner" android:layout_width="match_parent" android:layout_height="30dp" android:layout_gravity="bottom" android:layout_marginHorizontal="20dp" android:layout_marginBottom="82dp" android:textColor="@color/home_white" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_preview_title" android:layout_width="match_parent" android:layout_height="24dp" android:layout_gravity="bottom" android:layout_marginHorizontal="20dp" android:layout_marginBottom="51dp" android:textColor="@color/home_white" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        <androidx.appcompat.widget.AppCompatTextView android:id="@+id/home_preview_viewers" android:layout_width="match_parent" android:layout_height="22dp" android:layout_gravity="bottom" android:layout_marginHorizontal="20dp" android:layout_marginBottom="19dp" android:textColor="@color/home_white" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
    </FrameLayout>
</merge>
