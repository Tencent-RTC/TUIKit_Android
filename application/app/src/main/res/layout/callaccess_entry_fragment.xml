<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/callaccess_page_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/callaccess_entry_title"
            android:textColor="@color/callaccess_nav_title"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <com.tencent.uikit.app.call.entry.CallEntryView
        android:id="@+id/entry_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
