<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/callaccess_page_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/input_box"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/callaccess_bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/callaccess_icon_search" />

            <EditText
                android:id="@+id/id_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/callaccess_entry_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="32"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/callaccess_text"
                android:textColorHint="@color/callaccess_text3"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/search_clear"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/callaccess_bg_search_clear"
                android:contentDescription="@string/callaccess_entry_clear_input"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/callaccess_symbol_close"
                android:textColor="@color/callaccess_card"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/callaccess_bg_search_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/callaccess_entry_search"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selected_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/remain_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/callaccess_text2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/clear_selected"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="12dp"
                android:text="@string/callaccess_entry_clear"
                android:textColor="@color/callaccess_brand"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/callaccess_bg_selected"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:padding="10dp">

            <com.tencent.uikit.app.call.entry.TokenScrollView
                android:id="@+id/token_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.tencent.uikit.app.call.entry.TokenFlowView
                    android:id="@+id/token_flow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.tencent.uikit.app.call.entry.TokenScrollView>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/list_header"
        layout="@layout/callaccess_entry_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/contact_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <HorizontalScrollView
            android:id="@+id/param_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/media_chip"
                    style="@style/CallAccessChip" />

                <TextView
                    android:id="@+id/caption_chip"
                    style="@style/CallAccessChip"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/resolution_chip"
                    style="@style/CallAccessChip"
                    android:layout_marginStart="8dp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:minWidth="8dp" />

                <ImageView
                    android:id="@+id/settings_chip"
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:background="@drawable/callaccess_bg_chip"
                    android:contentDescription="@string/callaccess_entry_more_settings"
                    android:scaleType="center"
                    android:src="@drawable/callaccess_icon_settings" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/call_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/callaccess_bg_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/callaccess_entry_start_call"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
