<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_friend_avatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/callaccess_bg_avatar"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:outlineProvider="background"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/item_friend_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/callaccess_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/item_friend_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/callaccess_bg_tag"
            android:gravity="center"
            android:minWidth="34dp"
            android:text="@string/callaccess_entry_friends"
            android:textColor="@color/callaccess_brand"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/item_friend_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/callaccess_symbol_check"
            android:textColor="@color/callaccess_brand"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <View
        android:id="@+id/item_friend_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_gravity="bottom"
        android:background="@color/callaccess_line"
        android:visibility="gone" />

</FrameLayout>
