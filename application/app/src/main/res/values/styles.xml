<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TRTCLiveConfirmDialogFragment" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="xiaoshipin_AppDialogTheme" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="AppSpinnerStyle">
        <item name="android:textColor">@color/app_color_black</item>
        <item name="android:color">@color/app_color_white</item>
    </style>

    <style name="PopupInputCardAnim">
        <item name="android:windowEnterAnimation">@anim/app_popup_in_anim</item>
        <item name="android:windowExitAnimation">@anim/app_popup_out_anim</item>
    </style>

    <style name="App.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:background">@null</item>
        <item name="android:thumb">@drawable/app_switch_thumb</item>
        <item name="track">@drawable/app_switch_track</item>
        <item name="android:switchMinWidth">40dp</item>
        <item name="android:thumbTextPadding">0dp</item>
    </style>

    <style name="AppSheetAction" parent="Widget.AppCompat.Button">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/app_bg_sheet_action_primary</item>
    </style>
</resources>