<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demo_mainContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/demo_viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:id="@+id/demo_bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/demo_bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/demo_tab_messages"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/demo_tab_messages_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/demo_ic_tab_messages" />

                <TextView
                    android:id="@+id/demo_tab_messages_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="@string/demo_tab_messages"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/demo_tab_calls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/demo_tab_calls_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/demo_ic_tab_calls" />

                <TextView
                    android:id="@+id/demo_tab_calls_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="@string/demo_tab_calls"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/demo_tab_contacts"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/demo_tab_contacts_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/demo_ic_tab_contacts" />

                <TextView
                    android:id="@+id/demo_tab_contacts_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="@string/demo_tab_contacts"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/demo_tab_me"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/demo_tab_me_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/demo_ic_tab_me" />

                <TextView
                    android:id="@+id/demo_tab_me_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:text="@string/demo_tab_me"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <io.trtc.tuikit.chat.uikit.components.widgets.AvatarBadgeView
            android:id="@+id/demo_messageUnreadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible" />

        <io.trtc.tuikit.chat.uikit.components.widgets.AvatarBadgeView
            android:id="@+id/demo_contactsUnreadBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible" />
    </FrameLayout>

</LinearLayout>
