<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/demo_privacyDialogRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/demo_privacyContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:focusableInTouchMode="true"
        android:lineSpacingExtra="4dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/demo_privacyAgree"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/demo_login_privacy_agree"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/demo_privacyRefuse"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/demo_login_privacy_refuse"
        android:textSize="14sp" />
</LinearLayout>
