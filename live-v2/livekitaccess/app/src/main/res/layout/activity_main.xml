<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/btn_anchor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/anchor"
        app:layout_constraintBottom_toTopOf="@+id/btn_audience"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <Button
        android:id="@+id/btn_audience"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audience"
        app:layout_constraintBottom_toTopOf="@+id/btn_live_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_anchor" />

    <Button
        android:id="@+id/btn_live_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_list"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_audience" />

</androidx.constraintlayout.widget.ConstraintLayout>