<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="32dp"
    android:paddingEnd="20dp"
    android:paddingBottom="30dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/livekit_audience_profile_avatar_border"
        android:padding="2dp">

        <com.trtc.uikit.livekit.common.theme.avatar.AtomicAvatar
            android:id="@+id/iv_profile_avatar"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            app:avatarShape="round"
            app:avatarSize="l" />
    </FrameLayout>

    <com.trtc.uikit.livekit.common.theme.label.AtomicLabel
        android:id="@+id/tv_profile_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.trtc.uikit.livekit.common.theme.label.AtomicLabel
        android:id="@+id/btn_profile_follow"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/livekit_audience_profile_follow_bg"
        android:elevation="7dp"
        android:gravity="center"
        android:text="@string/common_follow_anchor"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
