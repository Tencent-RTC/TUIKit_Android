<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_gift_root"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:background="@drawable/livekit_gift_normal_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/ll_gift"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingTop="3dp"
        android:paddingEnd="2dp"
        android:paddingBottom="5dp">

        <FrameLayout
            android:id="@+id/fl_gift_icon_wrap"
            android:layout_width="54dp"
            android:layout_height="54dp">

            <ImageView
                android:id="@+id/iv_gift_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_gift_name"
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#F0FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_gift_price"
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/iv_price_coin"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/livekit_gift_price_coin" />

            <TextView
                android:id="@+id/tv_gift_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:textColor="#94FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_gift_price_selected"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="26dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/livekit_gift_price_coin" />

        <TextView
            android:id="@+id/tv_gift_price_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:textColor="#F0FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_gift_send"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/livekit_gift_send_button_bg"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="@string/common_gift_give_gift"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>