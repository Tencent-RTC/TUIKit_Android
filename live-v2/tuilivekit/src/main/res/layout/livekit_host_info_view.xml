<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.trtc.uikit.livekit.common.theme.avatar.AtomicAvatar
        android:id="@+id/iv_anchor_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/livekit_livelist_default_avatar"
        app:avatarShape="round"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/ll_anchor_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="2dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/iv_anchor_avatar"
        app:layout_constraintEnd_toStartOf="@id/btn_follow"
        app:layout_constraintStart_toEndOf="@id/iv_anchor_avatar"
        app:layout_constraintTop_toTopOf="@id/iv_anchor_avatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed">

        <com.trtc.uikit.livekit.common.theme.label.AtomicLabel
            android:id="@+id/tv_anchor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="0.017"
            android:maxLines="1"
            android:textColor="#FAFFFFFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.trtc.uikit.livekit.common.theme.label.AtomicLabel
                android:id="@+id/tv_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="150dp"
                android:textColor="#ADFFFFFF"
                android:textSize="8sp"
                tools:ignore="SmallSp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btn_follow"
        android:layout_width="wrap_content"
        android:layout_height="27dp"
        android:background="@drawable/livekit_player_follow_bg"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="44dp"
        android:paddingHorizontal="9dp"
        android:text="@string/common_follow_anchor"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_anchor_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_anchor_avatar" />

</merge>
