<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.trtc.uikit.livekit.player.video.PlayerVideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.trtc.uikit.livekit.player.living.LivingView
        android:id="@+id/player_overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.trtc.uikit.livekit.player.preview.PreviewView
        android:id="@+id/player_preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.trtc.uikit.livekit.player.summary.SummaryView
        android:id="@+id/player_summary_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/iv_close_live"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="57dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/livekit_player_action_bg"
        android:clickable="true"
        android:contentDescription="@string/livekit_livingtopbarview_close_desc"
        android:focusable="true"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/livekit_ic_living_close"
        android:visibility="gone" />

</FrameLayout>
