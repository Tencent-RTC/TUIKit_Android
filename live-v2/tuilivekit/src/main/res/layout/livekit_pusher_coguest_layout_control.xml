<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageView
        android:id="@+id/livekit_pusher_coguest_layout_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.trtc.uikit.livekit.common.theme.LiveText
        android:id="@+id/livekit_pusher_coguest_layout_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="12dp"
        android:maxLines="2"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="11sp"
        app:autoSizeMaxTextSize="13sp"
        app:autoSizeStepGranularity="1sp"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        app:liveTextRole="itemTitle"
        app:liveTextTone="secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/livekit_pusher_coguest_layout_icon"
        app:layout_constraintTop_toTopOf="parent" />

</merge>
