<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="30dp">
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_coguest_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/livekit_pusher_coguest_settings"
            app:liveTextRole="sheetTitle"
            android:minHeight="32dp"
            android:maxLines="2" />
        <com.trtc.uikit.livekit.common.theme.button.AtomicButton
            android:id="@+id/livekit_pusher_coguest_end_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:text="@string/livekit_pusher_coguest_end_all"
            android:visibility="gone"
            app:buttonColorType="danger"
            app:buttonTextSize="13sp"
            app:buttonVariant="text"
            app:customButtonSize="xs"
            android:minWidth="88dp"
            android:layout_marginStart="8dp" />
    </FrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/livekit_pusher_coguest_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="78dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="162dp"
                android:background="@drawable/livekit_pusher_coguest_section_background">
                <com.trtc.uikit.livekit.common.theme.LiveText
                    android:id="@+id/livekit_pusher_coguest_layout_section_title"
                    android:layout_width="0dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/livekit_pusher_coguest_layout"
                    app:liveTextRole="sectionTitle"
                    app:liveTextTone="secondary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestLayoutControl
                    android:id="@+id/livekit_pusher_coguest_layout_floating"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="11dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintEnd_toStartOf="@id/livekit_pusher_coguest_layout_grid2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/livekit_pusher_coguest_layout_section_title" />
                <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestLayoutControl
                    android:id="@+id/livekit_pusher_coguest_layout_grid2"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/livekit_pusher_coguest_layout_floating"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/livekit_pusher_coguest_layout_floating"
                    app:layout_constraintTop_toTopOf="@id/livekit_pusher_coguest_layout_floating" />
                <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestLayoutControl
                    android:id="@+id/livekit_pusher_coguest_layout_fixed"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintEnd_toStartOf="@id/livekit_pusher_coguest_layout_grid9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/livekit_pusher_coguest_layout_floating" />
                <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestLayoutControl
                    android:id="@+id/livekit_pusher_coguest_layout_grid9"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="@id/livekit_pusher_coguest_layout_fixed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/livekit_pusher_coguest_layout_fixed"
                    app:layout_constraintTop_toTopOf="@id/livekit_pusher_coguest_layout_fixed" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestUserSectionView
                android:id="@+id/livekit_pusher_coguest_connected"
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:layout_marginTop="12dp" />
            <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestUserSectionView
                android:id="@+id/livekit_pusher_coguest_applicants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
            <com.trtc.uikit.livekit.pusher.living.coguest.controlpanel.PusherCoGuestUserSectionView
                android:id="@+id/livekit_pusher_coguest_candidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
