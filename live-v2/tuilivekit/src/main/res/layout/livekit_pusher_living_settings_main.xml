<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="385dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_pause"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_mic"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="3" />
    </LinearLayout>

    <com.trtc.uikit.livekit.common.theme.LiveText
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="121dp"
        android:includeFontPadding="false"
        android:text="@string/livekit_settings_basic_group"
        app:liveTextRole="caption"
        app:liveTextTone="tertiary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="148dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_beauty"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />


        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_mirror"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_flip"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_sound_effect"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <com.trtc.uikit.livekit.common.theme.LiveText
        android:layout_width="wrap_content"
        android:layout_height="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="239dp"
        android:includeFontPadding="false"
        android:text="@string/livekit_settings_interaction_group"
        app:liveTextRole="caption"
        app:liveTextTone="tertiary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="266dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_background_music"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <com.trtc.uikit.livekit.pusher.settings.PusherSettingsItemView
            android:id="@+id/cap_comments"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_weight="1" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="3" />
    </LinearLayout>
</FrameLayout>
