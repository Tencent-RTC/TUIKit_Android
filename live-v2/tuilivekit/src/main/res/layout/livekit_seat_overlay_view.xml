<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/livekit_seat_name_shading"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/livekit_seat_name"
        app:layout_constraintBottom_toBottomOf="parent" />
    <FrameLayout
        android:id="@+id/livekit_seat_microphone_badge"
        android:layout_width="20dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/livekit_coguest_seat_muted_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_seat_microphone_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/livekit_coguest_seat_muted" />
    </FrameLayout>
    <com.trtc.uikit.livekit.common.theme.label.AtomicLabel
        android:id="@+id/livekit_seat_name"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="10sp"
        android:textStyle="normal"
        android:textColor="@color/livekit_coguest_seat_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</merge>
