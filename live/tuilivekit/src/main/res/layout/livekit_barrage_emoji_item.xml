<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/livekit_barrage_emoji_cell_size"
    android:clickable="true"
    android:focusable="true">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/livekit_barrage_emoji_image"
        android:layout_width="@dimen/livekit_barrage_emoji_cell_size"
        android:layout_height="@dimen/livekit_barrage_emoji_cell_size"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/livekit_barrage_emoji_fallback"
        android:layout_width="@dimen/livekit_barrage_emoji_cell_size"
        android:layout_height="@dimen/livekit_barrage_emoji_cell_size"
        android:layout_gravity="center"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/livekit_barrage_input_text"
        android:textSize="8sp"
        android:visibility="gone" />
</FrameLayout>
