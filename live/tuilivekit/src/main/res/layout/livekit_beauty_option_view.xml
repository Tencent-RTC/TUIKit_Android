<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/livekit_pusher_beauty_option_plate"
        android:layout_width="@dimen/livekit_pusher_beauty_plate_size"
        android:layout_height="@dimen/livekit_pusher_beauty_plate_size"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="@dimen/livekit_pusher_beauty_plate_top"
        android:background="@drawable/livekit_pusher_beauty_option_plate"
        android:duplicateParentState="true">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_pusher_beauty_option_icon"
            android:layout_width="@dimen/livekit_pusher_beauty_icon_size"
            android:layout_height="@dimen/livekit_pusher_beauty_icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <com.trtc.uikit.livekit.common.theme.LiveText
        android:id="@+id/livekit_pusher_beauty_option_label"
        android:layout_width="match_parent"
        android:layout_height="@dimen/livekit_pusher_beauty_option_label_height"
        android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/livekit_pusher_beauty_option_plate" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:includeFontPadding="false"
        app:liveTextRole="control"
        app:liveTextTone="secondary" />
</merge>
