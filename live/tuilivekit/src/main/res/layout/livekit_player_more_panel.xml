<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="37dp"
    android:layout_marginEnd="16dp"
    android:orientation="horizontal"
    android:weightSum="5">

    <LinearLayout
        android:id="@+id/livekit_player_more_quality_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="@string/livekit_player_more_auto"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:stateListAnimator="@animator/livekit_player_more_item_press">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/livekit_pusher_settings_item_plate"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/livekit_player_more_quality" />
        </FrameLayout>

        <TextView
            android:id="@+id/livekit_player_more_quality_label"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/livekit_player_more_auto"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/livekit_player_more_floating_item"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clickable="true"
        android:contentDescription="@string/livekit_player_more_floating"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp"
        android:stateListAnimator="@animator/livekit_player_more_item_press">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/livekit_pusher_settings_item_plate"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/livekit_float_window" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/livekit_player_more_floating"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
