<?xml version="1.0" encoding="utf-8"?>
<!--
  Content of one cover candidate: the loaded thumbnail plus the border plate that carries the
  picked / not picked stroke.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:id="@+id/livekit_pusher_cover_option_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/livekit_pusher_cover_option_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/livekit_pusher_cover_option_border"
        android:duplicateParentState="true" />
</merge>
