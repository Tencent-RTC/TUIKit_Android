<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/livekit_pusher_end_body"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="49dp"
        android:paddingBottom="24dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/livekit_pusher_end_audience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="31dp"
            android:textSize="14sp" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_end_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/livekit_pusher_end_confirm"
            app:liveTextRole="sheetTitle"
            android:minHeight="24dp"
            android:layout_marginTop="14dp" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_end_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/livekit_pusher_end_empty_audience"
            app:liveTextRole="body"
            app:liveTextTone="secondary"
            android:minHeight="22dp" />
        <LinearLayout
            android:id="@+id/livekit_pusher_end_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:baselineAligned="false">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/livekit_pusher_end_continue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/livekit_pusher_end_continue_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/livekit_pusher_end_continue"
                android:textColor="#EBFFFFFF"
                android:textSize="15sp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/livekit_pusher_end_confirm_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:background="@drawable/livekit_pusher_end_confirm_bg"
                android:elevation="8dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/livekit_pusher_end_end"
                android:textColor="#F0FFFFFF"
                android:textSize="15sp"
                android:layout_weight="1"
                android:minHeight="44dp"
                android:maxLines="2"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
