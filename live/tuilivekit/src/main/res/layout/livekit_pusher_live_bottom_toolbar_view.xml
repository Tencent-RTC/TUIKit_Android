<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/livekit_pusher_living_toolbar_pk"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="34dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="@string/livekit_pusher_living_toolbar_pk"
        android:layout_marginStart="@dimen/livekit_pusher_living_toolbar_pk_inset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_pusher_living_toolbar_pk_icon"
            android:layout_width="46dp"
            android:layout_height="38dp"
            android:translationY="-6dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/livekit_pusher_living_toolbar_pk" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_living_toolbar_pk_label"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="30dp"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8.25sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:shadowColor="@color/livekit_pusher_living_toolbar_label_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/livekit_pusher_living_toolbar_pk"
            app:liveTextRole="control"
            app:liveTextTone="secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/livekit_pusher_living_toolbar_coguest"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="34dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="@string/livekit_pusher_living_toolbar_coguest"
        android:layout_marginStart="@dimen/livekit_pusher_living_toolbar_pk_gap"
        app:layout_constraintStart_toEndOf="@id/livekit_pusher_living_toolbar_pk"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_pusher_living_toolbar_coguest_icon"
            android:layout_width="46dp"
            android:layout_height="38dp"
            android:translationY="-6dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/livekit_pusher_living_toolbar_coguest" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_living_toolbar_coguest_label"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="30dp"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8.25sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:shadowColor="@color/livekit_pusher_living_toolbar_label_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/livekit_pusher_living_toolbar_coguest"
            app:liveTextRole="control"
            app:liveTextTone="secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/livekit_pusher_living_toolbar_flip"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="34dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="@string/livekit_pusher_living_toolbar_flip"
        android:layout_marginEnd="@dimen/livekit_pusher_living_toolbar_action_gap"
        app:layout_constraintEnd_toStartOf="@id/livekit_pusher_living_toolbar_music"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_pusher_living_toolbar_flip_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:translationY="0.5dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/livekit_pusher_living_toolbar_flip" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_living_toolbar_flip_label"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="30dp"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8.25sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:shadowColor="@color/livekit_pusher_living_toolbar_label_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/livekit_pusher_living_toolbar_flip"
            app:liveTextRole="control"
            app:liveTextTone="secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/livekit_pusher_living_toolbar_music"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="34dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="@string/livekit_pusher_living_toolbar_music"
        android:layout_marginEnd="@dimen/livekit_pusher_living_toolbar_action_gap"
        app:layout_constraintEnd_toStartOf="@id/livekit_pusher_living_toolbar_more"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_pusher_living_toolbar_music_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:translationY="0.5dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/livekit_pusher_living_toolbar_music" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_living_toolbar_music_label"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="30dp"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8.25sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:shadowColor="@color/livekit_pusher_living_toolbar_label_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/livekit_pusher_living_toolbar_music"
            app:liveTextRole="control"
            app:liveTextTone="secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/livekit_pusher_living_toolbar_more"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:minWidth="34dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="@string/livekit_pusher_living_toolbar_more"
        android:layout_marginEnd="@dimen/livekit_pusher_living_toolbar_action_gap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/livekit_pusher_living_toolbar_more_icon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:translationY="0dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/livekit_pusher_living_toolbar_more" />
        <com.trtc.uikit.livekit.common.theme.LiveText
            android:id="@+id/livekit_pusher_living_toolbar_more_label"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginTop="30dp"
            android:gravity="top|center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8.25sp"
            app:autoSizeMaxTextSize="11sp"
            app:autoSizeStepGranularity="1sp"
            android:shadowColor="@color/livekit_pusher_living_toolbar_label_shadow"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/livekit_pusher_living_toolbar_more"
            app:liveTextRole="control"
            app:liveTextTone="secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
