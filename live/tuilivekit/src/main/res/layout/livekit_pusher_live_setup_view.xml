<?xml version="1.0" encoding="utf-8"?>
<!--
  Prepare header of the host entry, from the Ardot 准备页头部 / 封面+标题 node (390x153):
  the cover entry sits at the top centre, the title 90dp from the top, and the edit hint
  right below it.

  The cover caption overlays the thumbnail and shares its rounded clipping.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.trtc.uikit.livekit.pusher.prepare.PusherCoverThumbnailView
        android:id="@+id/livekit_pusher_prepare_cover_entry"
        android:layout_width="@dimen/livekit_pusher_prepare_cover_size"
        android:layout_height="@dimen/livekit_pusher_prepare_cover_size"
        android:contentDescription="@string/livekit_pusher_prepare_change_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/livekit_pusher_prepare_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="@dimen/livekit_pusher_prepare_cover_hint_height"
            android:layout_gravity="bottom"
            android:background="@color/livekit_pusher_prepare_cover_hint_background"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/livekit_pusher_prepare_change_cover"
            android:textColor="@color/livekit_pusher_prepare_hint"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="7sp"
            app:autoSizeMaxTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            android:fontFamily="sans-serif-medium"
            android:textSize="10sp" />
    </com.trtc.uikit.livekit.pusher.prepare.PusherCoverThumbnailView>

    <com.trtc.uikit.livekit.common.theme.LiveTextInputView
        android:id="@+id/livekit_pusher_prepare_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/livekit_pusher_prepare_title_height"
        android:padding="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/livekit_pusher_prepare_title_horizontal_inset"
        android:layout_marginTop="@dimen/livekit_pusher_prepare_title_top"
        android:layout_marginEnd="@dimen/livekit_pusher_prepare_title_horizontal_inset"
        android:background="@null"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:includeFontPadding="false"
        android:inputType="textMultiLine"
        android:minLines="1"
        android:maxLines="3"
        android:scrollHorizontally="false"
        android:textColor="@color/common_design_standard_flowkit_white"
        android:textSize="@dimen/livekit_pusher_prepare_title_text_size" />

    <TextView
        android:id="@+id/livekit_pusher_prepare_edit_hint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/livekit_pusher_prepare_edit_hint_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/livekit_pusher_prepare_title"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/livekit_edittopicview_edit_label"
        android:textColor="@color/livekit_pusher_prepare_hint"
        android:textSize="@dimen/livekit_pusher_prepare_edit_hint_text_size" />
</merge>
