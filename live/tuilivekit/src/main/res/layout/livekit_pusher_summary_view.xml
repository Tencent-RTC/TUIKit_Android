<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/livekit_pusher_summary_body"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:id="@+id/livekit_pusher_summary_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/livekit_summaryview_back">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/livekit_pusher_summary_back"
                android:contentDescription="@null" />
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:id="@+id/livekit_pusher_summary_title"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:textSize="24sp"
            android:textColor="@color/livekit_pusher_summary_text_primary"
            android:text="@string/livekit_summaryview_end"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="24sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/livekit_pusher_summary_time_range"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:textSize="14sp"
                    android:textColor="@color/livekit_pusher_summary_text_secondary"
                    android:minHeight="22dp"
                    app:lineHeight="22dp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/livekit_pusher_summary_pause_duration"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:textSize="14sp"
                    android:textColor="@color/livekit_pusher_summary_text_secondary"
                    android:minHeight="22dp"
                    app:lineHeight="22dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/livekit_pusher_summary_reason"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:textSize="14sp"
                    android:textColor="@color/livekit_pusher_summary_text_secondary"
                    android:minHeight="22dp"
                    app:lineHeight="22dp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/livekit_pusher_summary_income_background">
                <com.trtc.uikit.livekit.pusher.summary.SummaryMetricView
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:id="@+id/livekit_pusher_summary_gift_value" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/livekit_pusher_summary_divider" />
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <com.trtc.uikit.livekit.pusher.summary.SummaryMetricView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:id="@+id/livekit_pusher_summary_gifts" />
                    <Space
                        android:layout_width="16dp"
                        android:layout_height="0dp" />
                    <com.trtc.uikit.livekit.pusher.summary.SummaryMetricView
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:id="@+id/livekit_pusher_summary_gift_senders" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:padding="24dp"
                android:background="@drawable/livekit_pusher_summary_interaction_background">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:id="@+id/livekit_pusher_summary_section_title"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical"
                    android:textSize="15sp"
                    android:textColor="@color/livekit_pusher_summary_text_primary"
                    android:text="@string/livekit_summaryview_interaction_data"
                    android:maxLines="1" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="20dp">
                    <com.trtc.uikit.livekit.pusher.summary.SummaryMetricView
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:id="@+id/livekit_pusher_summary_viewers" />
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp" />
                    <com.trtc.uikit.livekit.pusher.summary.SummaryMetricView
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:id="@+id/livekit_pusher_summary_comments" />
                    <Space
                        android:layout_width="10dp"
                        android:layout_height="0dp" />
                    <com.trtc.uikit.livekit.pusher.summary.SummaryMetricView
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_weight="1"
                        android:id="@+id/livekit_pusher_summary_likes" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
