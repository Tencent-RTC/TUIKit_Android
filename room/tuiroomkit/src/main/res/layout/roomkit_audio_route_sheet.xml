<?xml version="1.0" encoding="utf-8"?>
<!-- 声音输出面板（对齐 iOS `RoomAudioRouteSheet` / 设计稿 `#speakerOverlay .h5-leave-sheet`）：
     面板内容四周留 12；
     行组 `.h5-leave-group`：圆角 16、内边距 6、行间距 2、底 `bg-canvas`；
     取消按钮：行组下方 8、高 48、圆角 12、底 `bg-canvas`、正文色 15sp。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/route_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/roomkit_bg_route_group"
        android:orientation="vertical"
        android:padding="6dp" />

    <Button
        android:id="@+id/route_cancel_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/roomkit_bg_route_cancel"
        android:stateListAnimator="@null"
        android:text="@string/roomkit_room_common_cancel"
        android:textAllCaps="false"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_lg" />

</LinearLayout>
