<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/roomkit_bg_speaker_popup_group"
        android:orientation="vertical">

        <TextView
            android:id="@+id/caption_view_full"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/roomkit_bg_speaker_popup_row"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/roomkit_caption_view_full"
            android:textColor="@color/roomkit_fg_primary"
            android:textSize="@dimen/roomkit_fs_lg" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/roomkit_border" />

        <TextView
            android:id="@+id/caption_close_live"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/roomkit_bg_speaker_popup_row"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/roomkit_caption_close"
            android:textColor="@color/roomkit_danger"
            android:textSize="@dimen/roomkit_fs_lg" />
    </LinearLayout>

    <Button
        android:id="@+id/caption_cancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/roomkit_bg_speaker_popup_cancel"
        android:stateListAnimator="@null"
        android:text="@string/roomkit_room_common_cancel"
        android:textAllCaps="false"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_lg"
        android:textStyle="normal" />

</LinearLayout>
