<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:id="@+id/room_info_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:background="@drawable/roomkit_bg_info_card"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/room_info_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/room_info_main_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/room_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.01"
                    android:singleLine="true"
                    android:textColor="@color/roomkit_fg_primary"
                    android:textSize="@dimen/roomkit_fs_md" />

                <View
                    android:id="@+id/room_info_divider"
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/roomkit_bg_divider" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/elapsed_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="'tnum' 1"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:text="00:00"
                    android:textColor="@color/roomkit_fg_secondary"
                    android:textSize="@dimen/roomkit_fs_md" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/room_info_second_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/room_info_caret"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/roomkit_icon_collapse_tertiary" />
    </FrameLayout>
</merge>
