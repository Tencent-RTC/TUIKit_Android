<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:id="@+id/fault_icon_container"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/roomkit_bg_fault_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/fault_icon_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/fault_title_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_lg"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fault_icon_container" />

    <TextView
        android:id="@+id/fault_desc_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/roomkit_fg_secondary"
        android:textSize="@dimen/roomkit_fs_md"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fault_title_text" />

    <Button
        android:id="@+id/fault_primary_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/roomkit_bg_fault_primary_button"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/roomkit_fg_on_accent"
        android:textSize="@dimen/roomkit_fs_lg"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fault_desc_text" />

    <Button
        android:id="@+id/fault_secondary_button"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/roomkit_bg_fault_secondary_button"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fault_primary_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
