<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/roomkit_bg_bottom_sheet_dialog_white"
    android:paddingBottom="20dp"
    tools:ignore="UnusedAttribute">

    <FrameLayout
        android:id="@+id/drag_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:padding="10dp"
            android:src="@drawable/roomkit_bg_drag_indicator"
            tools:ignore="ContentDescription" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/roomkit_schedule_success_and_invite_text"
        android:textColor="@color/roomkit_color_text_quaternary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/drag_indicator" />

    <TextView
        android:id="@+id/tv_room_name_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/roomkit_scheduled_room_name"
        android:textColor="@color/roomkit_color_g5"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_dialog_title" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_title_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="end"
        app:constraint_referenced_ids="tv_room_name_title,tv_room_time_title,tv_room_id_title,tv_room_password_title" />

    <TextView
        android:id="@+id/tv_room_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/roomkit_color_text_quaternary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_name_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier_title_end"
        app:layout_constraintTop_toTopOf="@+id/tv_room_name_title"
        tools:text="Jason's temporary room" />

    <TextView
        android:id="@+id/tv_room_time_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/roomkit_room_time"
        android:textColor="@color/roomkit_color_g5"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_name_title" />

    <TextView
        android:id="@+id/tv_room_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/roomkit_color_text_quaternary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_time_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier_title_end"
        app:layout_constraintTop_toTopOf="@+id/tv_room_time_title"
        tools:text="2024/06/27 10:39-11:39" />

    <TextView
        android:id="@+id/tv_room_id_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/roomkit_scheduled_room_id"
        android:textColor="@color/roomkit_color_g5"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_time_title" />

    <TextView
        android:id="@+id/tv_room_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/roomkit_color_text_quaternary"
        android:textSize="14sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_id_title"
        app:layout_constraintEnd_toStartOf="@+id/btn_copy_room_id"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/barrier_title_end"
        app:layout_constraintTop_toTopOf="@+id/tv_room_id_title"
        tools:text="938 234 230" />

    <ImageView
        android:id="@+id/btn_copy_room_id"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/roomkit_ic_copy_blue"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_id"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_room_id"
        app:layout_constraintTop_toTopOf="@+id/tv_room_id" />

    <TextView
        android:id="@+id/tv_room_password_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/roomkit_room_password_title"
        android:textColor="@color/roomkit_color_g5"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_id_title"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/tv_room_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/roomkit_color_text_quaternary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_password_title"
        app:layout_constraintEnd_toStartOf="@+id/btn_copy_password"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/barrier_title_end"
        app:layout_constraintTop_toTopOf="@+id/tv_room_password_title"
        tools:text="123456"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/btn_copy_password"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/roomkit_ic_copy_blue"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/tv_room_password_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_room_password"
        app:layout_constraintTop_toTopOf="@+id/tv_room_password_title"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btn_copy_link"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/roomkit_bg_outlined_button"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/roomkit_copy_room_info"
        android:textColor="@color/roomkit_color_primary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_room_password_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
