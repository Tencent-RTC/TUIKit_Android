<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_scheduled_room_item"
    android:layout_width="match_parent"
    android:layout_height="48dp">

    <TextView
        android:id="@+id/tv_room_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="200dp"
        android:textColor="@color/roomkit_color_text_quaternary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Jason's temporary room" />

    <ImageView
        android:id="@+id/img_owner_arrow_right"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/roomkit_ic_scheduled_arrow"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@id/tv_room_name"
        app:layout_constraintStart_toEndOf="@id/tv_room_name"
        app:layout_constraintTop_toTopOf="@id/tv_room_name" />

    <LinearLayout
        android:id="@+id/ll_enter_scheduled_room"
        android:layout_width="68dp"
        android:layout_height="32dp"
        android:background="@drawable/roomkit_btn_enter_scheduled_room"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/roomkit_scheduled_room_btn_enter"
            android:textColor="@color/roomkit_color_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_room_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="8dp"
            android:textColor="@color/roomkit_color_text_quaternary"
            android:textSize="14sp"
            tools:text="10:39 - 11:39" />

        <View
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="@color/roomkit_color_scheduled_room_date_text" />

        <TextView
            android:id="@+id/tv_room_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:textColor="@color/roomkit_color_text_quaternary"
            android:textSize="14sp"
            tools:text="938 234 230" />

        <View
            android:id="@+id/divide_status_line"
            android:layout_width="1dp"
            android:layout_height="10dp"
            android:background="@color/roomkit_color_scheduled_room_date_text"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_room_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:textColor="@color/roomkit_color_button_primary"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Running" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
