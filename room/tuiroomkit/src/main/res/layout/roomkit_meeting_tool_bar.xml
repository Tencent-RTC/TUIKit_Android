<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.trtc.uikit.roomkit.inroom.features.device.micbutton.MicButton
            android:id="@+id/microphone_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp" />

        <com.trtc.uikit.roomkit.inroom.features.device.camerabutton.CameraButton
            android:id="@+id/camera_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp" />

        <com.trtc.uikit.roomkit.inroom.features.device.speakerbutton.SpeakerButton
            android:id="@+id/speaker_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp" />

        <com.trtc.uikit.roomkit.inroom.features.participants.participantbutton.ParticipantButton
            android:id="@+id/members_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp" />

        <com.trtc.uikit.roomkit.inroom.common.toolbarbutton.RoomToolbarButton
            android:id="@+id/chat_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp" />

        <com.trtc.uikit.roomkit.inroom.common.toolbarbutton.RoomToolbarButton
            android:id="@+id/more_button"
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>
</merge>
