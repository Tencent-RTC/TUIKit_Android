<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include
            android:id="@+id/cell_share"
            layout="@layout/roomkit_more_menu_cell" />

        <include
            android:id="@+id/cell_captions"
            layout="@layout/roomkit_more_menu_cell" />

        <com.trtc.uikit.roomkit.inroom.features.recording.cloudrecordingbutton.CloudRecordingButton
            android:id="@+id/cell_record"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/cell_settings"
            layout="@layout/roomkit_more_menu_cell" />
    </LinearLayout>
</LinearLayout>
