<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="2dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.trtc.uikit.roomkit.base.avatar.RoomAvatar
        android:id="@+id/item_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:textColor="@color/roomkit_fg_primary"
            android:textSize="@dimen/roomkit_fs_md"
            android:id="@+id/item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxWidth="160dp"
            android:singleLine="true" />

        <TextView
            android:textColor="@color/roomkit_fg_secondary"
            android:textSize="@dimen/roomkit_fs_xs"
            android:textStyle="bold"
            android:text="@string/roomkit_participants_me"
            android:id="@+id/item_self_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/roomkit_bg_tag_self"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:textSize="@dimen/roomkit_fs_xs"
            android:textStyle="bold"
            android:textColor="@color/roomkit_role_owner_fg"
            android:text="@string/roomkit_participants_owner"
            android:id="@+id/item_owner_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/roomkit_bg_tag_owner"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:textColor="@color/roomkit_role_admin_fg"
            android:textSize="@dimen/roomkit_fs_xs"
            android:textStyle="bold"
            android:text="@string/roomkit_participants_admin"
            android:id="@+id/item_admin_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/roomkit_bg_tag_admin"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/item_sharing_tag"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/roomkit_bg_tag_owner"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_sharing_icon"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/roomkit_icon_screen_share_tag" />

            <TextView
                android:textColor="@color/roomkit_role_owner_fg"
                android:textSize="@dimen/roomkit_fs_xs"
                android:textStyle="bold"
                android:text="@string/roomkit_participants_sharing"
                android:id="@+id/item_sharing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_mic_status"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:padding="6dp"
        android:src="@drawable/roomkit_icon_microphone_on" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_cam_status"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:padding="6dp"
        android:src="@drawable/roomkit_icon_camera_on" />
</LinearLayout>
