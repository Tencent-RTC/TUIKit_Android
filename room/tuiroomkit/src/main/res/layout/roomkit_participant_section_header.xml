<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="28dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="0dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/section_chevron"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/roomkit_icon_chevron_down" />

    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/roomkit_fg_secondary"
        android:textSize="@dimen/roomkit_fs_sm"
        android:id="@+id/section_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/roomkit_fg_tertiary"
        android:textSize="@dimen/roomkit_fs_sm"
        android:id="@+id/section_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:includeFontPadding="false" />
</LinearLayout>
