<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <LinearLayout
        android:id="@+id/password_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/roomkit_bg_password_card"
        android:orientation="vertical"
        android:padding="36dp">

        <TextView
            android:id="@+id/password_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/roomkit_room_entry_password_title"
            android:textColor="@color/roomkit_fg_primary"
            android:textSize="@dimen/roomkit_fs_xl"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/password_field_row"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/roomkit_bg_password_field">

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="44dp"
                android:background="@null"
                android:gravity="center"
                android:hint="@string/roomkit_join_password_placeholder"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="numberPassword"
                android:letterSpacing="0.12"
                android:maxLength="6"
                android:padding="0dp"
                android:textColor="@color/roomkit_fg_primary"
                android:textColorHint="@color/roomkit_fg_tertiary"
                android:textSize="@dimen/roomkit_fs_lg" />

            <ImageButton
                android:id="@+id/password_eye"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="10dp"
                android:background="@null"
                android:contentDescription="@string/roomkit_schedule_show_password"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/roomkit_icon_eye_off"
                android:tint="@color/roomkit_fg_tertiary" />
        </FrameLayout>

        <TextView
            android:id="@+id/password_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/roomkit_danger"
            android:textSize="@dimen/roomkit_fs_sm"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/password_cancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/roomkit_bg_password_button_secondary"
                android:stateListAnimator="@null"
                android:text="@string/roomkit_room_common_cancel"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_fg_primary"
                android:textSize="@dimen/roomkit_fs_md"
                android:textStyle="bold" />

            <Button
                android:id="@+id/password_confirm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/roomkit_bg_password_button_primary"
                android:stateListAnimator="@null"
                android:text="@string/roomkit_calendar_join"
                android:textAllCaps="false"
                android:textColor="@color/roomkit_fg_on_accent"
                android:textSize="@dimen/roomkit_fs_md"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
