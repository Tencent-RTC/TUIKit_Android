<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/room_info_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-6dp"
        android:background="@drawable/roomkit_bg_info_card"
        android:foreground="?attr/selectableItemBackground"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/room_name_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-semibold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.012"
            android:maxWidth="124dp"
            android:singleLine="true"
            android:textColor="@color/roomkit_fg_primary"
            android:textSize="@dimen/roomkit_fs_md"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/room_info_divider"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_default="wrap" />

        <View
            android:id="@+id/room_info_divider"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/roomkit_bg_divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/elapsed_text"
            app:layout_constraintStart_toEndOf="@id/room_name_text"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/elapsed_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="'tnum' 1"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:singleLine="true"
            android:text="00:00"
            android:textColor="@color/roomkit_fg_secondary"
            android:textSize="@dimen/roomkit_fs_md"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/room_info_caret"
            app:layout_constraintStart_toEndOf="@id/room_info_divider"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/room_info_caret"
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/roomkit_icon_collapse_tertiary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/elapsed_text"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
