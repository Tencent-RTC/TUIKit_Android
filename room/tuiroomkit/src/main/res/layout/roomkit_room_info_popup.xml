<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/info_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_16" />

    <View
        android:id="@+id/info_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/roomkit_bg_info_divider" />

    <LinearLayout
        android:id="@+id/info_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/roomkit_room_info_host"
                android:textColor="@color/roomkit_fg_secondary"
                android:textSize="@dimen/roomkit_fs_lg" />

            <TextView
                android:id="@+id/host_name"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/roomkit_fg_primary"
                android:textSize="@dimen/roomkit_fs_lg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/roomkit_invitation_room_id"
                android:textColor="@color/roomkit_fg_secondary"
                android:textSize="@dimen/roomkit_fs_lg" />

            <TextView
                android:id="@+id/id_value"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/roomkit_fg_primary"
                android:textSize="@dimen/roomkit_fs_lg" />

            <ImageView
                android:id="@+id/id_copy_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/roomkit_bg_info_copy"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/roomkit_icon_copy_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/password_row"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/roomkit_schedule_password"
                android:textColor="@color/roomkit_fg_secondary"
                android:textSize="@dimen/roomkit_fs_lg" />

            <TextView
                android:id="@+id/password_value"
                android:layout_marginStart="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/roomkit_fg_primary"
                android:textSize="@dimen/roomkit_fs_lg" />

            <ImageView
                android:id="@+id/password_copy_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/roomkit_bg_info_copy"
                android:importantForAccessibility="no"
                android:padding="3dp"
                android:src="@drawable/roomkit_icon_copy_accent" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/info_invite"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/roomkit_bg_info_invite"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/roomkit_room_info_invitation"
        android:textColor="@color/roomkit_fg_on_accent"
        android:textSize="@dimen/roomkit_fs_lg" />
</LinearLayout>
