<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:room="http://schemas.android.com/apk/res-auto">

    <!-- 设计稿 mobile .rk-tile-flip：只有自己、且摄像头开着才显示，距左上各 8。 -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/flip_camera"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/roomkit_bg_tile_flip"
        android:contentDescription="@string/roomkit_room_view_flip_camera"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/roomkit_icon_flip_camera"
        android:visibility="gone" />

    <com.trtc.uikit.roomkit.base.avatar.RoomAvatar
        android:id="@+id/tile_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/screen_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/roomkit_fg_on_media"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/tile_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="6dp"
        android:background="@drawable/roomkit_bg_tile_footer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:showDividers="middle"
        android:divider="@drawable/roomkit_space_name_row">

        <FrameLayout
            android:layout_width="12dp"
            android:layout_height="12dp">

            <ImageView
                android:id="@+id/microphone_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />

            <com.trtc.uikit.roomkit.inroom.common.miclevel.RoomMicLevelView
                android:id="@+id/mic_level"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- 顺序对齐设计稿 `.rk-tile-name` 的 DOM：麦克风 → 角色标识 → 名字 → 「我」。 -->
        <!-- 设计稿 `.rk-role-mark`：16×16 圆形 + 白色角色图标。 -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/role_badge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:visibility="gone"
            android:importantForAccessibility="yes" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/roomkit_fg_on_media"
            android:textSize="10sp" />

        <!-- 设计稿 mobile .rk-name-me：高 16、最小宽 16、padding 0 4、字重 500。 -->
        <TextView
            android:id="@+id/local_badge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="16dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/roomkit_participants_me"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:background="@drawable/roomkit_bg_tile_border"
        android:id="@+id/speaking_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/net_mark"
        android:layout_width="wrap_content"
        android:layout_height="12dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:visibility="gone" />
</merge>
