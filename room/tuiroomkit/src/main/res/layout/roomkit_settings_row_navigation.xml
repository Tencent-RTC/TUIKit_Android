<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页「跳转行」：标题 + 右侧当前值 + 选中对勾（对齐 iOS RoomSettingsRow navigation）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:includeFontPadding="false"
        android:textColor="@color/roomkit_fg_tertiary"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/row_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/roomkit_icon_chevron_right_tertiary"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/row_check"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/roomkit_icon_check_accent"
        android:visibility="gone" />
</LinearLayout>
