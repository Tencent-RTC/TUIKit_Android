<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/speaker_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/roomkit_bg_speaker_popup_group"
        android:orientation="vertical"
        android:padding="6dp" />

    <Button
        android:id="@+id/speaker_cancel_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/roomkit_bg_speaker_popup_cancel"
        android:stateListAnimator="@null"
        android:text="@string/roomkit_room_common_cancel"
        android:textAllCaps="false"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_lg" />

</LinearLayout>
