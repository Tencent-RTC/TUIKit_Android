<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.trtc.uikit.roomkit.view.main.roomview.FocusRoomView
        android:id="@+id/view_focus_room"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.trtc.uikit.roomkit.view.main.roomview.GridRoomView
        android:id="@+id/view_grid_room"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.trtc.uikit.roomkit.view.main.roomview.RoomPipView
        android:id="@+id/view_screen_share_pip"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:visibility="gone" />

</FrameLayout>
