<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/top_bar_row"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <com.trtc.uikit.roomkit.inroom.features.roominfo.currentroominfo.RoomInfoView
            android:id="@+id/current_room_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.trtc.uikit.roomkit.inroom.features.roominfo.localnetworkinfo.LocalNetworkInfo
            android:id="@+id/local_network_info"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp" />

        <com.trtc.uikit.roomkit.inroom.features.recording.cloudrecordingstatus.CloudRecordingStatus
            android:id="@+id/cloud_recording_status"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/roomkit_bg_tag_recording"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="invisible" />

        <com.trtc.uikit.roomkit.inroom.features.roominfo.leaveroombutton.LeaveRoomButton
            android:id="@+id/leave_room_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp" />
    </LinearLayout>
</merge>
