<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_bg_surface"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/roomkit_caption_title"
        android:textColor="@color/roomkit_fg_primary"
        android:textSize="@dimen/roomkit_fs_lg"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="10dp">

        <EditText
            android:id="@+id/transcript_search"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:background="@drawable/roomkit_input_search_bg"
            android:drawableStart="@drawable/roomkit_icon_search"
            android:drawablePadding="6dp"
            android:hint="@string/roomkit_caption_search_native"
            android:imeOptions="actionDone"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/roomkit_fg_primary"
            android:textColorHint="@color/roomkit_fg_tertiary"
            android:textSize="@dimen/roomkit_fs_sm"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/transcript_copy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/roomkit_transcription_copy_all"
            android:padding="8dp"
            android:src="@drawable/roomkit_icon_copy" />

        <ImageView
            android:id="@+id/transcript_settings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/roomkit_caption_settings_native"
            android:padding="8dp"
            android:src="@drawable/roomkit_icon_settings"
            android:tint="@color/roomkit_fg_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transcript_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/transcript_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:src="@drawable/roomkit_icon_caption"
                android:tint="@color/roomkit_fg_tertiary" />

            <TextView
                android:id="@+id/transcript_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.7"
                android:textColor="@color/roomkit_fg_tertiary"
                android:textSize="@dimen/roomkit_fs_sm" />
        </LinearLayout>

        <ImageView
            android:id="@+id/transcript_jump"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/roomkit_bg_transcript_jump"
            android:contentDescription="@string/roomkit_transcription_jump_latest"
            android:elevation="4dp"
            android:padding="6dp"
            android:src="@drawable/roomkit_icon_collapse"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
