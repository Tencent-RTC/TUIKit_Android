<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomkit_color_bg_home"
    android:orientation="vertical">

    <com.trtc.uikit.roomkit.base.ui.RoomTopBar
        android:id="@+id/top_bar_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/roomkit_color_white"
        app:title="@string/roomkit_chat" />

    <io.trtc.tuikit.chat.uikit.pages.ChatPageView
        android:id="@+id/chat_page_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
