<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 底部弹层里的整宽菜单按钮（对齐设计稿 views/native 的 .profile-sheet-setting：
         高 44、radius 12、fs-lg(16sp) semibold；底色由各按钮单独指定）。
         注：`minimumWidth` / `minimumHeight` 是 TextView 的属性、不是 style attribute，
         min* 系列请在布局里用 `android:minWidth` / `android:minHeight`。
         AppCompatButton 的默认最小宽高会撑开按钮，所以在布局里显式置 0。 -->
    <style name="RoomKitSheetAction" parent="Widget.AppCompat.Button">
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/roomkit_bg_sheet_action_primary</item>
    </style>

    <!-- 全组件统一的开关：40×22 track + 20 thumb（对齐 iOS UISwitch 的视觉尺寸）。
         `android:checked` 各处不同，不写进 style，由布局自己指定。 -->
    <style name="RoomKit.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:background">@null</item>
        <item name="android:thumb">@drawable/roomkit_switch_thumb</item>
        <item name="track">@drawable/roomkit_switch_track</item>
        <item name="android:switchMinWidth">40dp</item>
        <item name="android:thumbTextPadding">0dp</item>
    </style>
</resources>
